generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRADOR
  RECEPCION
  TECNICO
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         UserRole @default(RECEPCION)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedOrders RepairOrder[] @relation("AssignedTechnician")

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  whatsapp  String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  equipment Equipment[]
  orders    RepairOrder[]

  @@index([phone])
  @@index([whatsapp])
  @@map("customers")
}

model Equipment {
  id             String   @id @default(cuid())
  customerId     String
  type           String
  brand          String?
  model          String?
  serialNumber   String?
  accessories    String?
  physicalState  String?
  passwordHint   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id])
  orders         RepairOrder[]

  @@index([customerId])
  @@index([serialNumber])
  @@map("equipment")
}

enum RepairStatus {
  RECIBIDO
  PENDIENTE_DIAGNOSTICO
  DIAGNOSTICO_COMPLETADO
  ESPERANDO_APROBACION
  APROBADO
  EN_REPARACION
  ESPERANDO_REPUESTOS
  LISTO_PARA_ENTREGAR
  ENTREGADO
  CANCELADO
}

model RepairOrder {
  id                String       @id @default(cuid())
  orderNumber       String       @unique
  customerId        String
  equipmentId       String
  technicianId      String?
  reportedProblem   String
  diagnosis         String?
  workDone          String?
  status            RepairStatus @default(RECIBIDO)
  estimatedDate     DateTime?
  receivedAt        DateTime     @default(now())
  deliveredAt       DateTime?
  sourceSystem      String       @default("ROMANA")
  externalId        String?
  externalUpdatedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  customer          Customer     @relation(fields: [customerId], references: [id])
  equipment         Equipment    @relation(fields: [equipmentId], references: [id])
  technician        User?        @relation("AssignedTechnician", fields: [technicianId], references: [id])
  history           OrderHistory[]
  budgets           Budget[]
  payments          Payment[]

  @@unique([sourceSystem, externalId])
  @@index([status])
  @@index([receivedAt])
  @@index([customerId])
  @@map("repair_orders")
}

model OrderHistory {
  id            String       @id @default(cuid())
  orderId       String
  userId        String?
  action        String
  previousStatus RepairStatus?
  newStatus     RepairStatus?
  comment       String?
  createdAt     DateTime     @default(now())
  order         RepairOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_history")
}

model Budget {
  id        String       @id @default(cuid())
  orderId   String
  labor     Decimal      @default(0) @db.Decimal(12, 2)
  parts     Decimal      @default(0) @db.Decimal(12, 2)
  other     Decimal      @default(0) @db.Decimal(12, 2)
  discount  Decimal      @default(0) @db.Decimal(12, 2)
  total     Decimal      @default(0) @db.Decimal(12, 2)
  notes     String?
  createdBy String?
  createdAt DateTime     @default(now())
  order     RepairOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("budgets")
}

model Payment {
  id        String      @id @default(cuid())
  orderId   String
  amount    Decimal     @db.Decimal(12, 2)
  method    String?
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())
  order     RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model WhatsappTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String?
  body      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_templates")
}

model SyncRun {
  id          String   @id @default(cuid())
  sourceSystem String  @default("CP_REPARACIONES")
  status      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  newRecords  Int      @default(0)
  updatedRecords Int   @default(0)
  duplicateRecords Int @default(0)
  errors      Int      @default(0)
  message     String?  @db.Text

  @@index([startedAt])
  @@index([sourceSystem])
  @@map("sync_runs")
}

model ImportStaging {
  id           String   @id @default(cuid())
  sourceSystem String
  externalId   String
  entityType   String
  payload      String   @db.LongText
  fingerprint  String
  status       String   @default("PENDING")
  error        String?  @db.Text
  receivedAt   DateTime @default(now())
  processedAt  DateTime?

  @@unique([sourceSystem, externalId, entityType])
  @@index([status])
  @@index([fingerprint])
  @@map("import_staging")
}
